# ═══════════════════════════════════════════════════════════
#  Production Environment — CHANGE THESE VALUES
# ═══════════════════════════════════════════════════════════

# Database (keep defaults or change for security)
DB_USERNAME=ragllm
DB_PASSWORD=ragllm

# JWT Secret (CHANGE THIS — minimum 32 characters)
JWT_SECRET=CHANGE-ME-generate-a-secure-random-string-of-at-least-32-chars

# ─── API Keys (REQUIRED) ────────────────────────────────
# OpenAI (required for GPT models, embeddings, TTS)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (optional — leave empty to disable Gemini models)
GEMINI_API_KEY=

# Anthropic Claude (optional — leave empty to disable Claude models)
ANTHROPIC_API_KEY=
